{
  "name": "@rundol/monorepo",
  "version": "0.39.3",
  "description": "Git-based project analysis, design and task validation CLI",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runtime-co-kr/rundol.git"
  },
  "homepage": "https://github.com/runtime-co-kr/rundol#readme",
  "bugs": {
    "url": "https://github.com/runtime-co-kr/rundol/issues"
  },
  "type": "commonjs",
  "scripts": {
    "skill:install": "node scripts/install-global-skill.js --force",
    "build:editor": "node scripts/build-editor.js",
    "build:licenses": "node scripts/build-licenses.js",
    "check:fixture": "node bin/rdl.js check --root test/fixtures/workspace",
    "test": "node test/run.js",
    "test:packages": "node test/packages.test.js",
    "test:install": "node test/install.test.js && node test/tarball-compat.test.js",
    "typecheck": "tsc --noEmit",
    "version:check": "node scripts/version-check.js",
    "release:check": "npm run version:check && npm run typecheck && npm test && npm run test:install",
    "prepare": "node scripts/build-editor.js && node scripts/build-licenses.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "mermaid": "^11.12.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "remark-wiki-link": "^2.0.1",
    "typescript": "^7.0.2",
    "unified": "^11.0.5"
  }
}
